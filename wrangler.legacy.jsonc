{
  // Historical configuration only. The ssteiner deployment was retired on 2026-09-18.
  // Its Worker, storage, container, image, and Turnstile widget were deleted; do not deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ytdw",
  "account_id": "224ecf06b47e8b9e86863aca7726c5eb",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAEeANLj7coT90tAS",
    "TURNSTILE_HOSTNAMES": "ytdw.ssteiner.workers.dev",
    "MIGRATION_TARGET": "https://ytdw.fyi"
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CLIENT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "GLOBAL_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 10 } },
    { "name": "REQUEST_RATE_LIMIT", "namespace_id": "61003", "simple": { "limit": 10, "period": 60 } },
    { "name": "SHARE_READ_RATE_LIMIT", "namespace_id": "61004", "simple": { "limit": 60, "period": 60 } },
    { "name": "SHARE_GLOBAL_RATE_LIMIT", "namespace_id": "61005", "simple": { "limit": 300, "period": 60 } }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/s/*", "/health", "/metadata", "/captions"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "containers": [{
    "class_name": "Sandbox",
    "image": "registry.cloudflare.com/224ecf06b47e8b9e86863aca7726c5eb/ytdw-sandbox@sha256:dc66600b6b8c57db2861d769cf48fb5b9424642479f740883f55ac718cf721a5",
    "instance_type": "lite",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [
    { "class_name": "Sandbox", "name": "Sandbox" },
    { "class_name": "Coordinator", "name": "COORDINATOR" },
    { "class_name": "SharedBrief", "name": "SHARED_BRIEFS" }
  ] },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" },
    { "new_sqlite_classes": ["Coordinator"], "tag": "v2" },
    { "new_sqlite_classes": ["SharedBrief"], "tag": "v3" }
  ]
}
